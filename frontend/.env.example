# Copy to .env.local. Values in .env.local are visible in the browser, so keep this setup for local demos only.

# Empty = use mock data for every feature API.
VITE_API_URL=

# Avatar provider: mock (default). No free avatar service is configured yet.
VITE_AVATAR_PROVIDER=mock

# Try-on provider: mock (default) or idm-vton (free Hugging Face demo).
VITE_TRYON_PROVIDER=mock

# Hugging Face Space used by the idm-vton provider.
VITE_IDM_VTON_SPACE=yisol/IDM-VTON

# Optional. Your own Hugging Face token gives a larger ZeroGPU quota. Never commit it.
VITE_HF_TOKEN=
